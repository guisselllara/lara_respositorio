SELECT SUM(Price) AS Total_price FROM Products

--Usar la funcion MAX para mostrar el precio mas alto junto al nombre de ese producto de la tabla Products
SELECT ProductName, Price
FROM Products
WHERE Price=(SELECT MAX(price)FROM Products);

--Usar la funcion MIN para mostrar el precio mas bajo junto al nombre de ese producto de la tabla Products
SELECT ProductName, Price
FROM Products
WHERE Price=(SELECT MIN(price)FROM Products);

--Utilizar una consulta que muestre los nombres que empiecen con 'D' Y terminen en 'o'
SELECT * FROM Employees
WHERE LastName like 'D%O'

--Utiliza una consulta que muestre los apellidos que tengan un tamaño de 4 caracteres y terminen con 'c'
SELECT *
FROM Employees
WHERE LastName LIKE &quot;_____a&quot;

--Realizar una consulta que muestre el promedio de cantidades vendidas por ID de productos OrderDetails
SELECT ProductID, avg(Quantity)
FROM OrderDetails
GROUP by ProductID

--Realizar una consulta que muestre el total de cantidades vendidas por ID ordenes,
--antes de eso se necesita, trabajar unicamente con los ID de ordenes de detalles entre 0 y 40
SELECT ProductID, sum (Quantity)
FROM OrderDetails
GROUP by ProductID
HAVING Quantity BETWEEN 0 and 40</sql><sql name="SQL 10">--Mostrar los clientes que sean de la ciudad de mexico, londres o belice
SELECT * FROM customers
WHERE City IN ( 'London', 'Mexico')
or Country in ('Belice')
Order BY City DESC

--Mostrar las ordenes que se hisieron entre los años 1996 y 1997
SELECT * 
FROM Orders
WHERE strftime('%Y', OrderDate) BETWEEN '1996' AND '1997';


--Mostrar los precio de los rproductos que se encuentran entre 0 y 20 o 30
SELECT Price
FROM Products
WHERE (Price BETWEEN 0 AND 20) OR (Price &gt; 30);


</sql><sql name="SQL 1">--1
