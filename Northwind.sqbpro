-- 40
SELECT EmployeeID, COUNT(*) AS OrderCount
FROM Orders
GROUP BY EmployeeID
HAVING COUNT(*) &gt; 10;

-- 41
SELECT * 
FROM Products
WHERE Price &gt; (SELECT avg (Price) FROM Products);


-- 42
SELECT p.ProductName, SUM(od.Quantity * p.Price) AS TotalSales
FROM OrderDetails od
JOIN Products p ON od.ProductID = p.ProductID
GROUP BY p.ProductName
HAVING TotalSales &gt; 1000;


-- 43
SELECT DISTINCT c.CustomerID, c.CustomerName
FROM Customers c
JOIN Orders o ON c.CustomerID = o.CustomerID
JOIN OrderDetails od ON o.OrderID = od.OrderID
JOIN Products p ON od.ProductID = p.ProductID
JOIN Categories cat ON p.CategoryID = cat.CategoryID
WHERE cat.CategoryName = 'Beverages';


-- 44
SELECT SupplierID, SupplierName, Country
FROM Suppliers
WHERE Country NOT IN ('USA', 'UK');


--45
SELECT p.ProductName, SUM(od.Quantity) AS TotalSold
FROM OrderDetails od
JOIN Products p ON od.ProductID = p.ProductID
GROUP BY p.ProductName
ORDER BY TotalSold DESC
LIMIT 5;


-- 46
SELECT ProductName, Price, Unit
FROM Products
WHERE Price &gt; (SELECT AVG(Price) FROM Products)
AND CAST(Unit AS INTEGER) &gt; 50;


-- 47
SELECT DISTINCT c.CustomerID, c.CustomerName
FROM Customers c
JOIN Orders o ON c.CustomerID = o.CustomerID
WHERE o.OrderDate &gt; '1995-01-01' 
AND c.Country = 'Germany';


-- 48
SELECT EmployeeID, FirstName, LastName, BirthDate
FROM Employees
WHERE BirthDate BETWEEN '1970-01-01' AND '1980-01-01';


-- 49
SELECT p.ProductName, SUM(od.Quantity) AS TotalUnitsSold
FROM OrderDetails od
JOIN Products p ON od.ProductID = p.ProductID
GROUP BY p.ProductName
ORDER BY TotalUnitsSold DESC
LIMIT 10;


-- 50
SELECT ProductName, Price, Unit
FROM Products
WHERE Price &lt; 15
AND CAST(Unit AS INTEGER) &gt; 20;

-- 51
SELECT cat.CategoryName, SUM(od.Quantity * p.Price) AS TotalSales
FROM OrderDetails od
JOIN Products p ON od.ProductID = p.ProductID
JOIN Categories cat ON p.CategoryID = cat.CategoryID
GROUP BY cat.CategoryName
HAVING TotalSales &gt; 5000; .

</sql><sql name="SQL 5*">SELECT  CategoryID, ProductName,
(SELECT CategoryName FROM categories WHERE Products.CategoryID=CategoryID) as nombre_categoria,
sum(price) as Total_por_categoria
FROM Products
WHERE SupplierID BETWEEN 0 AND 10 GROUP BY CategoryID
having total_por_categoria BETWEEN 100 and 300
ORDER BY CategoryID DESC

SELECT CategoryID, ProductName
FROM Products

select * from Categories

--Realizar una consulta que permita mostrar el promedio de cantidades vendidas por id de productos,
--Ademas unicamente debe trabajar con los id de las ordenes de detalles 1,4,5,6,7,10,22,11,24 у 35
--Finalmente agrupe los campos y muestre las cantidades que unicamente
--Se encuentren en el rango de 5-30 y ordene de forma DESC a traves del campo del cual saco el promedio.

SELECT ProductID, PromedioCantidad
FROM (
SELECT ProductID, AVG(Quantity) AS PromedioCantidad
FROM OrderDetails
WHERE OrderDetailID IN (1, 4, 5, 6, 7, 10, 22, 11, 24, 35)
GROUP BY ProductID
) AS Subconsulta
WHERE PromedioCantidad BETWEEN 5 AND 30
ORDER BY PromedioCantidad DESC;

--Realizar una consulta que muestre las fechas de las ordenes
--realizadas por clientes, se necesita que los datos mostrados
--Se liminten a las ordenes que id (10248,10250,10260,10270,10249,10251)
--Ordene de forma  desc por employeed
SELECT OrderID, OrderDate, EmployeeID
FROM Orders
WHERE OrderID IN (
SELECT OrderID 
FROM Orders 
WHERE OrderID IN (10248, 10250, 10260, 10270, 10249, 10251)
)
ORDER BY EmployeeID DESC;


--Crear una consulta que permita mostrar el total de cantidades vendidad
--por ProductID, ademas se necesita saber el nombre del producto 
--limite a que unicamente  se muestren la informacion de los id de Las
--ordenes entre (10248 y 10280 y 10300 y 10400)
--mostrar las cantidades vendidas mayores a 30 
--Ordene de forma DESC por producto id
SELECT od.ProductID, p.ProductName,
sum(od.Quantity) AS TotalCantidadVendida
FROM OrderDetails od
JOIN Products p ON od.ProductID = p.ProductID
WHERE od.OrderID IN 
(SELECT OrderID
FROM Orders
WHERE (OrderID BETWEEN 10248 and 10280)
OR (OrderID BETWEEN 10300 and 10400)
)
GROUP BY od.ProductID, p.ProductName
HAVING TotalCantidadVendida &gt; 30
ORDER BY od.ProductID DESC;

</sql><current_tab id="3"/></tab_sql></sqlb_project>
